# Default is an offline, extractive demonstration; no API key or model download.
RAG_MODE=demo
OPENAI_API_KEY=
RAG_CHAT_MODEL=gpt-5-mini
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_RERANKER=none
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_CHUNK_WORDS=220
RAG_OVERLAP_WORDS=30
RAG_CANDIDATE_K=20
RAG_TOP_K=5
RAG_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
